{
  "manifest_version": 3,
  "name": "SKOPE — Workspace Manager",
  "version": "0.1.0",
  "description": "Organize Chrome tab groups into saved workspaces.",
  "permissions": ["sidePanel", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open SKOPE",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
